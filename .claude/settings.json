{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(crapper *)",
      "Bash(dryer *)",
      "Bash(mutator *)",
      "Bash(git *)",
      "Bash(gh repo view*)",
      "Bash(gh api *)",
      "Bash(ls *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)",
      "Bash(git push *+*)",
      "Bash(git reset *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/build-gate.mjs\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$CLAUDE_PROJECT_DIR\"; d=$(mktemp -d) || exit 2; i=$(git -C \"$r\" log -1 --format=%H \"--grep=^chore: install build mode$\" -- .factory/build.json); if [ -z \"$i\" ] || ! git -C \"$r\" archive \"$i\" .claude/hooks | tar -x -C \"$d\"; then echo \"build mode: cannot load the Stop hook from the install commit\" >&2; rm -rf \"$d\"; exit 2; fi; node \"$d/.claude/hooks/build-gate.mjs\" stop; s=$?; rm -rf \"$d\"; if [ \"$s\" -ne 0 ]; then echo \"build mode: the Stop hook crashed (exit $s)\" >&2; exit 2; fi",
            "timeout": 6420
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/fix-mode-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
